# ---------------------------------------------------------------------------
# Auto Cluster (ACDRI) — environment
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------------------

# Public site origin. Used for canonical URLs, sitemap.xml and robots.txt.
# Never a localhost or staging domain in production — see docs/audit §7.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Payload) ----------------------------------------------------
# PostgreSQL. Required before the Payload admin is wired in. Until then, the
# app runs on the interim file-backed store in src/server/store.ts — see
# README.md "Connecting Payload" for what changes when this is set.
DATABASE_URI=postgres://user:password@localhost:5432/autocluster

# Payload encryption key. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# --- Staff console (src/server/auth.ts) -------------------------------------
# Signs staff session cookies. Generate with: openssl rand -hex 32
# After setting this, create the first account with:
#   ADMIN_EMAIL=you@example.com ADMIN_PASSWORD=... npm run seed:admin
STAFF_SESSION_SECRET=

# Vercel Cron (or any external scheduler) hits /api/cron/enquiry-nudges with
# this as a Bearer token. Generate with: openssl rand -hex 32. Leave unset in
# local dev — the route skips the check when this is empty.
CRON_SECRET=

# --- Email (enquiry + booking notifications) -------------------------------
# Without a key the enquiry API logs to the console instead of sending,
# so local development works with no mail provider configured.
RESEND_API_KEY=
EMAIL_FROM="Auto Cluster <no-reply@autoclusterpune.org>"

# Seed values for the routing map (src/server/routing.ts) the first time it
# runs — after that, edit routing from /staff/settings/routing instead of
# here. See CONTENT_QUESTIONS.md CQ-07 — ACDRI must confirm which of
# marketing@ / marketing2@ / info@ owns each of these.
EMAIL_TO_TESTING=marketing@autoclusterpune.org
EMAIL_TO_PROTOTYPING=marketing@autoclusterpune.org
EMAIL_TO_VENUE=marketing@autoclusterpune.org
EMAIL_TO_TRAINING=marketing@autoclusterpune.org
EMAIL_TO_CAREERS=marketing@autoclusterpune.org
EMAIL_TO_TENDERS=marketing@autoclusterpune.org
EMAIL_TO_GENERAL=info@autoclusterpune.org
EMAIL_FALLBACK=marketing@autoclusterpune.org

# --- Analytics -------------------------------------------------------------
# Existing container from the current site. Tag config must be rebuilt.
NEXT_PUBLIC_GTM_ID=GTM-WWZZQQJ

# --- Maps ------------------------------------------------------------------
# Place ID pin, not an address query string — see docs/audit/11-contact-us.md
NEXT_PUBLIC_MAPS_PLACE_ID=
